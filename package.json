{
  "name": "gtm-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "node scripts/generate-map-data.js && node scripts/generate-stats.js && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "node scripts/lint.mjs",
    "lint:comms": "node scripts/lint-comms.mjs",
    "scan:slop": "node scripts/scan-slop.mjs",
    "check:depth": "node scripts/check-depth.mjs",
    "check:sources": "node scripts/validate-sources.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "check": "npm run lint && npm run lint:comms && npm run scan:slop && npm run check:depth && npm run check:sources && npm run check:freshness",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit"
  },
  "dependencies": {
    "@docusaurus/core": "3.7.0",
    "@docusaurus/preset-classic": "3.7.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "webpackbar": "^7.0.0"
  },
  "devDependencies": {
    "@docusaurus/types": "3.7.0",
    "webpack": "^5.109.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "overrides": {
    "@docusaurus/bundler": {
      "webpackbar": "7.0.0"
    }
  }
}
