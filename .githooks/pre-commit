#!/bin/sh
# gtm-wiki author-time lint (L2). Blocks a commit that would ship slop or a
# build trap. Only checks staged .md/.mdx files so it stays fast.
#
# Wire it up once per clone:  npm run setup:hooks
# (sets core.hooksPath to .githooks; the hook file is committed and shared.)
set -e

# ---------------------------------------------------------------------------
# Gate 0 — Operating-context freshness (deterministic recovery pointer).
# Any wiki authoring must happen against the consolidated operating context,
# not whatever the agent happens to remember. This gate makes "where is the
# context stored" a hard check, not a habit. It runs on EVERY commit.
CTX="$HOME/.hermes/plans/gtm-wiki/OPERATING_CONTEXT.md"
if [ ! -f "$CTX" ]; then
  echo
  echo "Commit blocked: consolidated operating context is missing."
  echo "Run: skill_manage view 'buzz-wiki-handoff' (or read the file):"
  echo "  $CTX"
  echo "This wiki is rebuilt from that context; do not author without it."
  exit 1
fi
# A stale context (older than 45 days) is a warning the author must refresh.
# We do NOT hard-block on age — the file may legitimately be stable — but we
# print the reminder so the author re-verifies it reflects current reality.
if [ -f "$CTX" ]; then
  age_days=$(($(date +%s) - $(stat -f %m "$CTX" 2>/dev/null || stat -c %Y "$CTX" 2>/dev/null)))
  age_days=$((age_days / 86400))
  if [ "$age_days" -gt 45 ]; then
    echo "gtm-wiki pre-commit: WARNING operating context is $age_days days old."
    echo "  Refresh $CTX (or verify it is current) before relying on it."
  fi
fi
# ---------------------------------------------------------------------------

# Non-interactive stashes are risky in shared hooks; lint staged files only.
# Scope to docs/ (the reader-facing tree) PLUS RESEARCH/ + STANDARDS/
# (internal team meta). RESEARCH/gtm-wiki/SOURCES_REGISTRY.md is walked by
# lint.mjs on every deploy (INTERNAL_ROOTS) — a banned token or em dash there
# fails the whole deploy. It is written by the corpus ingest cron 4x/day, so
# a poisoned registry can otherwise be committed invisibly and only die on
# Vercel. Lint the internal roots at commit time too.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(docs|RESEARCH|STANDARDS)/.*\.(md|mdx)$' || true)
if [ -z "$staged" ]; then
  exit 0
fi

echo "gtm-wiki pre-commit: linting staged content files..."
if ! node scripts/lint.mjs $staged; then
  echo
  echo "Commit blocked: lint violations in staged files."
  echo "Fix them (or, for a legit one-off, git commit --no-verify)."
  exit 1
fi

# S9 slop scan on the same staged files. Hard violations block; WARN
# candidates (two-fragment, uncited dated-stat) print for the human eye.
echo "gtm-wiki pre-commit: running S9 slop scan on staged files..."
node scripts/scan-slop.mjs $staged
exit 0
